{
  "name": "Assistente LGPD Dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/ui/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.useEnvFile": true,
        "terminal.integrated.env.linux": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ]
    }
  },

  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "pip install uv && uv venv .venv --clear && uv pip install -r requirements.txt torchvision nest_asyncio streamlit",
  
  "postAttachCommand": "echo 'Ambiente configurado! Lembre-se de ativar o ambiente virtual executando: source .venv/bin/activate'"
}