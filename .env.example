# Copie para .env e preencha. NUNCA commitar .env.
# Escolha 1 provider principal para chat.

# Opção A — Groq free tier (recomendado para este projeto)
GROQ_API_KEY=gsk_substitua_aqui
# GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings locais para funcionar sem chave extra
EMBED_PROVIDER=local
EMBED_MODEL_LOCAL=all-MiniLM-L6-v2

# Opção B — Gemini Free Tier
GEMINI_API_KEY=AIza_substitua_aqui

# Opção C — OpenAI ($5 free credit)
# OPENAI_API_KEY=sk-substitua

# Opção D — Anthropic ($5 free credit, expira 14d após claim)
# ANTHROPIC_API_KEY=sk-ant-substitua

# Modelos (ajuste conforme provider)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-haiku-4.5

# Embeddings remotos, caso queira usar Gemini/OpenAI em vez do modelo local
# EMBED_PROVIDER=remote
# EMBED_MODEL=gemini-embedding-001
# EMBED_MODEL=text-embedding-3-small

# Opcional — observabilidade (descomente se for usar Langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
